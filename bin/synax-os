#!/usr/bin/env python3
"""SYNAX-OS Sovereign Agentic Operating System Entrypoint."""

import sys
import os
from pathlib import Path

# Ensure src/ is on PYTHONPATH
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from synax.os_app import run_os_server

if __name__ == "__main__":
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8796
    print(f"🚀 Booting SYNAX-OS Sovereign Kernel & Window Manager on http://localhost:{port}...")
    run_os_server(port=port)
